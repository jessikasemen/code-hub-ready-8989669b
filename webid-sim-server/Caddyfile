# Caddyfile für WebID-Simulations-Proxy.
# Catch-All :443, on_demand_tls fragt vorher den Bun-Proxy, ob die Domain
# eine registrierte Simulationsdomain ist (verhindert Cert-Spam).

{
	email {$ACME_EMAIL}

	on_demand_tls {
		ask http://127.0.0.1:3002/_internal/ask
		interval 2m
		burst    5
	}
}

http:// {
	redir https://{host}{uri} 308
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3002 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}