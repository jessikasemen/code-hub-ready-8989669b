# Vorlage für die SERVER-Konfiguration.
# Auf dem Portal-Server als /opt/apps/portal/.env.server ablegen —
# diese Datei wird von deploy.sh bevorzugt und nie durch `git pull` überschrieben.
# Werte: self-hosted Supabase hinter der eigenen Domain, ANON_KEY aus
# /opt/supabase/docker/.env.
SUPABASE_URL="https://api.mb-portal.com"
SUPABASE_PUBLISHABLE_KEY="<ANON_KEY des self-hosted Supabase>"
VITE_SUPABASE_URL="https://api.mb-portal.com"
VITE_SUPABASE_PUBLISHABLE_KEY="<ANON_KEY des self-hosted Supabase>"

# Nur für Deploy/Migrations auf dem Server (scripts/deploy.sh, scripts/migrate.sh)
# TARGET_DB_URL=postgresql://postgres:PASSWORT@190.97.167.123:5432/postgres
